<launch>
  <!--
    Brings up the full clothing-detection pipeline with a single command:
        roslaunch clothing_detection clothing_detection.launch
  -->

  <arg name="camera_index" default="0"
       doc="Index of the video device opened by OpenCV (/dev/videoN)."/>
  <arg name="image_topic"  default="/image_output"
       doc="Topic carrying frames from the camera to the detector."/>
  <arg name="threshold"    default="0.15"
       doc="Minimum confidence to accept a garment detection."/>

  <node pkg="clothing_detection" type="camera_node.py" name="camera_node" output="screen">
    <param name="camera_index" value="$(arg camera_index)"/>
    <param name="image_topic"  value="$(arg image_topic)"/>
  </node>

  <node pkg="clothing_detection" type="clothing_detector_node.py" name="clothing_detector_node" output="screen">
    <param name="image_topic" value="$(arg image_topic)"/>
    <param name="threshold"   value="$(arg threshold)"/>
  </node>
</launch>
